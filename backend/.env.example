# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/calendar_app
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=calendar_app
# TypeORM: schema via migrations (synchronize desativado por padrão)
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
TYPEORM_LOGGING=false

PORT=5000
JWT_SECRET=dev-only-change-me-in-production-32chars
JWT_EXPIRATION=1h

VALKEY_HOST=localhost
VALKEY_PORT=6379

# E-mail (exportação .ics para o celular) — SMTP genérico (Gmail/Outlook/custom)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password
MAIL_FROM=seu-email@gmail.com
